{
    "name": "primocys/validity-kit",
    "description": "Laravel application authorization toolkit",
    "type": "library",
    "license": "MIT",
    "keywords": ["validity-kit", "laravel", "license", "purchase-code", "validation"],
    "homepage": "https://github.com/Primocys-kishan/validity-kit",
    "authors": [
        {
            "name": "Primocys"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ValidityKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ValidityKit\\ValidityKitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
