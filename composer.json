{
    "name": "primocys/laravel-license-validator",
    "description": "Laravel package for purchase validation and license verification",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Primocys\\LicenseValidator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Primocys\\LicenseValidator\\LicenseValidatorServiceProvider"
            ]
        }
    }
}